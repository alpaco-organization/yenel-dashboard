db:
  host: localhost
  port: 5432
  name: yenel-dashboard
  user: postgres
  password: your-password-here

crypto:
  private_key: |
    -----BEGIN PRIVATE KEY-----
    (your RSA private key here)
    -----END PRIVATE KEY-----
  public_key: |
    -----BEGIN PUBLIC KEY-----
    (your RSA public key here)
    -----END PUBLIC KEY-----
  access_token_expires_minute: 30
  refresh_token_expires_days: 7
  algorithm: "RS256"

cors_origins:
  - "http://localhost:3000"
  - "http://127.0.0.1:3000"

webhook_secret: "change-me-to-a-random-string"
